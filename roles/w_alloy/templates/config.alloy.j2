// Managed by Ansible - roles/w_alloy/templates/config.alloy.j2
// systemd journal -> Loki, host metrics -> Prometheus

logging {
  level  = "info"
  format = "logfmt"
}

// ---------------------------------------------------------------- logs

// Promote journal metadata to Loki labels. Kept small: each label
// multiplies the number of streams Loki has to keep.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "journal" {
  forward_to    = [loki.process.journal.receiver]
  relabel_rules = loki.relabel.journal.rules
  max_age       = "{{ w_alloy_journal_max_age }}"
}

loki.process "journal" {
  forward_to = [loki.write.loki.receiver]

  // Set after the source, because loki.source.journal overrides
  // its own labels argument with the component name.
  stage.static_labels {
    values = {
      job  = "journald",
      host = "{{ inventory_hostname }}",
    }
  }
}

loki.write "loki" {
  endpoint {
    url = "{{ w_alloy_loki_endpoint }}"
  }
}

// -------------------------------------------------------- fail2ban logs

// fail2ban logs to a file, not journald, so it needs its own source.
local.file_match "fail2ban" {
  path_targets = [{
    __path__ = "/var/log/fail2ban.log",
    job      = "fail2ban",
    host     = "{{ inventory_hostname }}",
  }]
}

loki.process "fail2ban" {
  forward_to = [loki.write.loki.receiver]

  stage.multiline {
    firstline     = "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
    max_wait_time = "3s"
  }

  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) (?P<component>\\S+)\\s*\\[(?P<pid>\\d+)\\]: (?P<level>\\S+)\\s+(?:\\[(?P<jail>[^\\]]+)\\]\\s+)?(?P<message>.*)$"
  }

  // Without this Loki stores the ingest time, so the timeline would show
  // when Alloy started rather than when the event happened.
  stage.timestamp {
    source   = "timestamp"
    format   = "2006-01-02 15:04:05,000"
    location = "Local"
  }

  // Low-cardinality fields only. The banned IP stays in the log line and is
  // extracted at query time. As a label it would create one stream per IP.
  stage.labels {
    values = {
      level     = "level",
      component = "component",
      jail      = "jail",
    }
  }
}

loki.source.file "fail2ban" {
  targets    = local.file_match.fail2ban.targets
  forward_to = [loki.process.fail2ban.receiver]
}

// ------------------------------------------------------------- metrics

// node_exporter built into Alloy. No separate service needed.
prometheus.exporter.unix "node" { }

// Default instance label would be 127.0.0.1:port. Use the inventory name
// so metrics and logs can be correlated on the same host identifier.
discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }

  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "node" {
  targets         = discovery.relabel.node.output
  forward_to      = [prometheus.remote_write.prometheus.receiver]
  scrape_interval = "{{ w_alloy_scrape_interval }}"
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "{{ w_alloy_prometheus_endpoint }}"
  }
}

